{
  "name": "down-to-earth",
  "version": "1.1.0",
  "description": "A production countdown timer and projector controller for live rooms, services, and events.",
  "author": {
    "name": "Codemon"
  },
  "copyright": "Copyright © 2026 Codemon",
  "main": "main.js",
  "engines": {
    "node": ">=20.9.0"
  },
  "build": {
    "appId": "com.codemon.downtoearth",
    "productName": "Down to Earth",
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "icon": "build/icon",
    "files": [
      "main.js",
      "preload.js",
      "controller/controller/out/**/*",
      "build/icon.png",
      "build/icon.icns",
      "build/icon.ico",
      "renderer.html",
      "renderer.js",
      "projector.html",
      "projector.js",
      "package.json",
      "!dist/**/*",
      "!controller/controller/node_modules/**/*",
      "!controller/controller/.next/**/*",
      "!controller/controller/.turbo/**/*"
    ],
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "build/icon.icns",
      "category": "public.app-category.productivity"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "artifactName": "${productName}-${version}-windows-${arch}-setup.${ext}"
    },
    "portable": {
      "artifactName": "${productName}-${version}-windows-${arch}-portable.${ext}"
    },
    "extraResources": []
  },
  "scripts": {
    "start": "electron .",
    "controller:dev": "cd controller/controller && pnpm dev --hostname 127.0.0.1 --port 3000",
    "controller:build": "cd controller/controller && pnpm build",
    "typecheck:controller": "cd controller/controller && pnpm typecheck",
    "lint:controller": "cd controller/controller && pnpm lint",
    "release:check": "npm run typecheck:controller && npm run lint:controller && npm run controller:build",
    "release:mac": "npm run release:check && electron-builder --mac --arm64",
    "release:mac:universal": "npm run release:check && electron-builder --mac --universal",
    "release:win": "npm run release:check && electron-builder --win --x64",
    "website:dev": "cd website/down-to-earth-site && pnpm dev --hostname 127.0.0.1 --port 3001",
    "website:build": "cd website/down-to-earth-site && pnpm build",
    "website:lint": "cd website/down-to-earth-site && pnpm lint",
    "website:typecheck": "cd website/down-to-earth-site && pnpm typecheck",
    "dist": "electron-builder",
    "dist:mac-intel": "electron-builder --mac --x64",
    "dist:mac-arm": "electron-builder --mac --arm64",
    "dist:win": "electron-builder --win --x64"
  },
  "devDependencies": {
    "electron": "^39.2.4",
    "electron-builder": "^26.0.12",
    "electron-reload": "^2.0.0-alpha.1"
  },
  "dependencies": {
    "express": "^5.2.1",
    "network-address": "^1.1.2",
    "qrcode": "^1.5.4",
    "socket.io": "^4.8.3"
  }
}
